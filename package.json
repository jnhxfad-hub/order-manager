{
  "name": "order-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "backup:real-db": "node scripts/backup-real-db.mjs",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "check": "pnpm run typecheck && pnpm run test:shared-utils && pnpm run test:processing-fees && pnpm run test:export-file && pnpm run test:inventory-utils && pnpm run test:inventory-api-fallback && pnpm run test:order-form-utils && pnpm run test:customer-form-utils && pnpm run test:customer-api-fallback && pnpm run test:product-api-fallback && pnpm run test:order-api-fallback && pnpm run test:settings-api && pnpm run test:operational-scripts && pnpm run build",
    "check:rust": "cd src-tauri && cargo fmt --check && cargo clippy --all-targets --all-features -- -D warnings && cargo test",
    "check:all": "pnpm run check && pnpm run check:rust",
    "check:full": "pnpm run check && pnpm exec playwright test",
    "desktop:acceptance": "node scripts/desktop-acceptance.mjs",
    "restore:real-db": "node scripts/restore-real-db.mjs",
    "test:customer-api-fallback": "node tests/node/test-customer-api-fallback.mjs",
    "test:customer-form-utils": "node tests/node/test-customer-form-utils.mjs",
    "test:export-file": "node tests/node/test-export-file.mjs",
    "test:inventory-api-fallback": "node tests/node/test-inventory-api-fallback.mjs",
    "test:inventory-utils": "node tests/node/test-inventory-utils.mjs",
    "test:order-api-fallback": "node tests/node/test-order-api-fallback.mjs",
    "test:order-form-utils": "node tests/node/test-order-form-utils.mjs",
    "test:operational-scripts": "node tests/node/test-operational-scripts.mjs",
    "test:processing-fees": "node tests/node/test-processing-fees.mjs",
    "test:product-api-fallback": "node tests/node/test-product-api-fallback.mjs",
    "test:settings-api": "node tests/node/test-settings-api.mjs",
    "test:shared-utils": "node tests/node/test-shared-utils.mjs",
    "test:ui": "playwright test",
    "preview": "vite preview",
    "db:reset": "rm -f \"$HOME/Library/Application Support/com.jnhxf.order-manager/order-manager.sqlite\" \"$HOME/Library/Application Support/com.jnhxf.order-manager/order-manager.sqlite-shm\" \"$HOME/Library/Application Support/com.jnhxf.order-manager/order-manager.sqlite-wal\"",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:debug-app": "tauri build --debug --bundles app && (nohup 'src-tauri/target/debug/bundle/macos/铝材订单管理系统.app/Contents/MacOS/order-manager' >/tmp/order-manager-debug.log 2>&1 &)"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-router": "^1.170.8",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "shadcn": "^4.8.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
